{
    "name": "link-shortener",
    "version": "1.5.0",
    "private": true,
    "author": {
        "name": "William Kang",
        "email": "william@wkang.ca"
    },
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "test": "bun test",
        "typecheck": "bun check",
        "format": "bun fmt",
        "format:check": "bun fmt --check",
        "lint": "bun lint --max-warnings 0",
        "lint:fix": "bun lint --fix",
        "verify": "bun run format:check && bun run lint && bun run typecheck && bun test",
        "seed": "NODE_ENV=development bun scripts/seed.ts",
        "backup": "bun scripts/backup.ts",
        "bench": "bun scripts/bench.ts"
    },
    "dependencies": {
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "bowser": "^2.14.1",
        "country-flag-emoji-polyfill": "^0.1.10",
        "isbot": "^5.2.2",
        "jose": "^6.2.12",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "uplot": "^1.6.32",
        "uqr": "^0.1.3",
        "zod": "^4.1.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "typescript": "^7.0.2"
    }
}
