# Copy to .env for local overrides (Bun loads .env automatically).
# In production, set these in your container platform's environment settings.

# NODE_ENV=production

# Listener ports: one for short links, one for the dashboard.
SHORT_PORT=3000
DASH_PORT=3001

# Public origins, no trailing slash. Required in production; default to
# http://localhost:<port> in development.
# SHORT_ORIGIN=https://s.example
# DASH_ORIGIN=https://dash.example

# SQLite file. The Docker image uses /data/links.db; mount a volume at /data.
DB_PATH=./data/links.db

# Cloudflare Access protecting the dashboard (Zero Trust > Access > Applications >
# your dashboard app > Overview). Required in production; leave unset locally to skip auth.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=<Application Audience (AUD) Tag>

# Secret mixed into the daily visitor hash (unique visitors). Set it in production,
# or unique-visitor counts reset on every restart. Generate: bun -e "console.log(crypto.randomUUID())"
# VISITOR_SALT=

# Backups (bun run backup): where to write, and how many to keep.
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=14
